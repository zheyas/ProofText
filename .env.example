# .env.example
# На Render эти переменные задаются через render.yaml и Dashboard,
# файл .env нужен только для локального запуска.

# Настройки Django
SECRET_KEY="Здесь должен быть уникальный секретный ключ, сгенерированный с помощью python -c 'import os; print(os.urandom(24).hex())'"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Настройки базы данных PostgreSQL
DB_NAME=DB_NAME
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432

SAPLING_API_KEY=YOUR_SAPLING_API_KEY

# Сколько фрагментов доклада искать в DuckDuckGo за одну проверку
SEARCH_MAX_FRAGMENTS=10

# Модель Hugging Face для оценки AI-генерации
AI_MODEL_NAME=openai-community/roberta-base-openai-detector
